# =============================================================================
# Public — embedded in the client bundle at BUILD time (NEXT_PUBLIC_*)
# =============================================================================
# URL the browser uses to reach Django/DRF (host machine or public domain).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Frontend origin — Auth.js redirects, absolute links, Open Graph.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# Server-only — read at RUNTIME (never exposed to the browser)
# =============================================================================
# Internal URL for Server Components, Auth.js, and route handlers inside Docker.
# Omit locally to fall back to NEXT_PUBLIC_API_URL.
API_URL=http://backend:8000/api/v1

# Auth.js — generate with: openssl rand -hex 32
AUTH_SECRET=replace-with-openssl-rand-hex-32

# Auth.js canonical URL (must match how users reach the frontend).
AUTH_URL=http://localhost:3000

# =============================================================================
# Optional
# =============================================================================
PORT=3000
NODE_ENV=development
